[Unit]
Description=PunDad production API and worker managed by PM2
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/srv/pundad/production/current/api
EnvironmentFile=/etc/pundad/production/api.env
Environment=PATH=/opt/pundad/node-v24.12.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=PM2_HOME=/var/lib/pundad-production/pm2
ExecStart=/opt/pundad/node-v24.12.0/bin/node /opt/pundad/pm2/bin/pm2-runtime start /etc/pundad/production/ecosystem.config.cjs
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
UMask=0022
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pundad-production /var/www/pundad-uploads
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1G
CPUQuota=150%
TasksMax=256

[Install]
WantedBy=multi-user.target
